# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Database (generated locally by seed/migrations)
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
coverage/
.nyc_output/

# Exports generated at runtime
exports/

# Local database backups (npm run backup)
database/backups/

# Import Center: spreadsheets awaiting mapping. Removed once the job commits.
database/uploads/

# Demonstration Excel files. Generated by  npm run sample:data  from the same
# field catalogue the importer uses, so they are never out of date and there is
# no reason to carry binaries in the repository. The README explaining them is
# generated alongside and is tracked.
sample-data/*
!sample-data/README.md
