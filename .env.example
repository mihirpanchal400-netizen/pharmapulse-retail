# ---------------------------------------------------------------
# PharmaPulse Retail - example environment configuration
# Copy this file to server/.env and adjust as needed.
# NEVER commit a real .env file.
# ---------------------------------------------------------------

# Port the Express API listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Path to the SQLite database file, relative to the repository root
DATABASE_PATH=./database/pharmapulse.db

# Secret used to sign session tokens (JWT).
# Generate your own, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-any-real-use

# Token lifetime
JWT_EXPIRES_IN=12h

# CORS origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173
